# {{ ansible_managed }}
VERIFIER_PUBLIC_URL=https://{{ verifier_domain }}
VERIFIER_SESSION_SECRET={{ vault_verifier_session_secret }}
VERIFIER_IDENTITY_PROVIDERS={{ verifier_identity_providers | join(',') }}
VERIFIER_APP_NAME={{ verifier_app_name }}
VERIFIER_OPERATOR_CONTACT={{ verifier_operator_contact }}
VERIFIER_SOURCE_URL={{ verifier_repo | regex_replace('\.git$', '') }}
# The data folder is on the LUKS volume unlocked by hand at boot (stated on /about).
VERIFIER_STORAGE_ENCRYPTED=true
VERIFIER_RP_REGISTRAR={{ verifier_rp_registrar }}
VERIFIER_RP_REGISTER_URL={{ verifier_rp_register_url }}
{% if verifier_uses_test_wallets %}
VERIFIER_TEST_WALLET_URL=https://{{ verifier_test_wallet_domain }}
{% endif %}
{% if verifier_uses_eudi %}
VERIFIER_EUDI_ENDPOINT=http://eudi-verifier:8080
{% endif %}
{% if verifier_uses_swiyu %}
VERIFIER_SWIYU_ENDPOINT=http://swiyu-verifier:8080
VERIFIER_SWIYU_ISSUER_DIDS={{ verifier_swiyu_issuer_dids | join(',') }}
VERIFIER_SWIYU_VCT_VALUES={{ verifier_swiyu_vct_values | join(',') }}
{% endif %}
